# Development habilita Swagger en /swagger (solo para pruebas locales; en producción deja Production o quita la línea).
# ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexión de SOLO LECTURA a ServiceDesk Plus. Nunca subir el .env real.
ConnectionStrings__ServiceDesk=Server=10.0.3.8;Database=servicedesk10_5;User Id=S4CONSULTA;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True;ApplicationIntent=ReadOnly;Application Name=SoporteBlunk.Api
# Orígenes permitidos para el frontend (CORS), separados por índice:
# Cors__Origins__0=http://localhost:5173
# Clave de firma de la sesión (mínimo 32 caracteres, aleatoria). Si cambia, todas las sesiones se invalidan.
Auth__JwtKey=<cadena-aleatoria-de-48-o-mas-caracteres>
# URL de apiseguridad (se puede sobrescribir por entorno).
# Seguridad__BaseUrl=https://sistema.prodig.com.mx:8819/

# Opcionales: sin ellas, los endpoints que dependen de cada una responden 503 (no impide arrancar la API).
# Jobs de SQL Server Agent (GET /v1/utilerias/jobs): msdb del servidor 10.0.3.8, mismo usuario de solo lectura.
# ConnectionStrings__Msdb=Server=10.0.3.8;Database=msdb;User Id=S4CONSULTA;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True;ApplicationIntent=ReadOnly;Application Name=SoporteBlunk.Api
# Usuarios MICROSIP/FORTIA (GET /v1/utilerias/microsip/*): servidor con los linked servers MICROSIP_CONFIG y FORTIA.
# ConnectionStrings__Microsip=Server=10.0.3.8;Database=master;User Id=S4CONSULTA;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True;ApplicationIntent=ReadOnly;Application Name=SoporteBlunk.Api
# Solo si el PUT de MICROSIP necesita un usuario distinto al de lectura; si se omite se usa ConnectionStrings__Microsip.
# ConnectionStrings__MicrosipEscritura=Server=10.0.3.8;Database=master;User Id=<usuario-con-escritura>;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True;Application Name=SoporteBlunk.Api
# Base de conocimiento, Bitácora, Auditoría y Archivos de confianza (SoporteKB, con escritura).
# ConnectionStrings__SoporteKB=Server=192.168.6.160;Database=SoporteKB;User Id=<usuario>;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True;Application Name=SoporteBlunk.Api
